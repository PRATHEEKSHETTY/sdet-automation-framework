<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SDET Negative Test Suite" parallel="none">

    <listeners>
        <listener class-name="com.sdet.reports.ExtentTestListener"/>
    </listeners>

    <test name="Negative Tests">

        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>

        <classes>
            <class name="com.sdet.ui.LoginTest"/>
            <class name="com.sdet.ui.CheckoutTest"/>
            <class name="com.sdet.api.PostsApiTest"/>
        </classes>

    </test>

</suite>
