<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SDET Automation Suite"
       parallel="classes"
       thread-count="2">

    <listeners>
        <listener class-name="com.sdet.reports.ExtentTestListener"/>
    </listeners>

    <test name="UI and API Tests">

        <classes>
            <class name="com.sdet.ui.LoginTest"/>
            <class name="com.sdet.ui.CheckoutTest"/>
            <class name="com.sdet.api.PostsApiTest"/>
            <class name="com.sdet.api.AuthApiTest"/>
        </classes>

    </test>

</suite>
